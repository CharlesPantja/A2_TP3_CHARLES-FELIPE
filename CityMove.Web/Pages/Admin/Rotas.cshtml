@page
@model CityMove.Web.Pages.Admin.RotasModel
@{
    ViewData["Title"] = "Gestão de Rotas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Gestão de Rotas</h1>
    <a asp-page="/Painel" class="btn btn-link px-0">&larr; Voltar ao painel</a>
</div>

@if (!string.IsNullOrEmpty(Model.Mensagem))
{
    <div class="alert alert-success">@Model.Mensagem</div>
}
@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="alert alert-danger">@Model.Erro</div>
}

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card cm-card">
            <div class="card-body">
                <h2 class="h5 mb-3">@(Model.Editando ? "Editar rota" : "Nova rota")</h2>
                <form method="post" asp-page-handler="Salvar">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-2">
                        <label class="form-label">Linha</label>
                        <select asp-for="LinhaId" class="form-select" required>
                            <option value="">Selecione...</option>
                            @foreach (var l in Model.Linhas)
                            {
                                <option value="@l.Id">@l.Codigo - @l.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Descrição</label>
                        <input asp-for="Descricao" class="form-control" required maxlength="160" placeholder="Ex.: Terminal Central → Terminal Sul" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Sentido</label>
                        <select asp-for="Sentido" class="form-select">
                            @foreach (var s in CityMove.Web.Pages.Admin.RotasModel.Sentidos)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Ativa" class="form-check-input" />
                        <label class="form-check-label">Rota ativa</label>
                    </div>
                    <button type="submit" class="btn btn-cm">@(Model.Editando ? "Salvar alterações" : "Cadastrar")</button>
                    @if (Model.Editando)
                    {
                        <a asp-page="/Admin/Rotas" class="btn btn-link">Cancelar</a>
                    }
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card cm-card">
            <div class="card-body">
                <h2 class="h5 mb-3">Rotas cadastradas (@Model.Rotas.Count)</h2>
                @if (Model.Rotas.Count == 0)
                {
                    <p class="text-muted m-0">Nenhuma rota cadastrada.</p>
                }
                else
                {
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Descrição</th><th>Sentido</th><th>Ativa</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.Rotas)
                        {
                            <tr>
                                <td>@r.Descricao</td>
                                <td>@r.Sentido</td>
                                <td>@(r.Ativa ? "Sim" : "Não")</td>
                                <td class="text-end text-nowrap">
                                    <a asp-page="/Admin/Rotas" asp-route-editId="@r.Id" class="btn btn-sm btn-cm-outline">Editar</a>
                                    <form method="post" asp-page-handler="Excluir" class="d-inline"
                                          onsubmit="return confirm('Remover esta rota?');">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
