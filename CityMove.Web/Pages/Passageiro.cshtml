@page
@model CityMove.Web.Pages.PassageiroModel
@{
    ViewData["Title"] = "Painel do Passageiro";
}

<h1 class="h3 mb-1">Painel do Passageiro</h1>
<p class="text-muted">Veja suas notificações e avalie suas viagens.</p>

@if (!string.IsNullOrEmpty(Model.Mensagem)) { <div class="alert alert-success">@Model.Mensagem</div> }
@if (!string.IsNullOrEmpty(Model.Erro)) { <div class="alert alert-danger">@Model.Erro</div> }

<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card cm-card h-100"><div class="card-body">
            <h2 class="h5 mb-3">⭐ Avaliar viagens</h2>
            @if (Model.Ctx is null || Model.Ctx.Avaliaveis.Count == 0)
            {
                <p class="text-muted m-0">Você não tem viagens concluídas para avaliar no momento.</p>
            }
            else
            {
                @foreach (var v in Model.Ctx.Avaliaveis)
                {
                    <form method="post" asp-page-handler="Avaliar" class="border-bottom pb-3 mb-3">
                        <input type="hidden" asp-for="ViagemId" value="@v.ViagemId" />
                        <input type="hidden" asp-for="PassageiroId" value="@Model.Ctx.PassageiroId" />
                        <div class="mb-2">
                            <strong>@v.Linha</strong>
                            <span class="text-muted">· viagem #@v.ViagemId</span>
                        </div>
                        <div class="row g-2 align-items-end">
                            <div class="col-4">
                                <label class="form-label">Nota</label>
                                <select asp-for="Nota" class="form-select">
                                    @for (int n = 5; n >= 1; n--)
                                    {
                                        <option value="@n">@n ★</option>
                                    }
                                </select>
                            </div>
                            <div class="col-8">
                                <label class="form-label">Comentário (opcional)</label>
                                <input asp-for="Comentario" class="form-control" placeholder="Como foi a viagem?" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-cm btn-sm mt-2">Enviar avaliação</button>
                    </form>
                }
            }
        </div></div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card cm-card h-100"><div class="card-body">
            <h2 class="h5 mb-3">🔔 Notificações</h2>
            @if (Model.Ctx is null || Model.Ctx.Notificacoes.Count == 0)
            {
                <p class="text-muted m-0">Nenhuma notificação.</p>
            }
            else
            {
                @foreach (var n in Model.Ctx.Notificacoes)
                {
                    <div class="d-flex justify-content-between align-items-start border-bottom py-2">
                        <span>@n.Mensagem</span>
                        <small class="text-muted text-nowrap ms-3">@n.EnviadaEm.ToLocalTime().ToString("dd/MM HH:mm")</small>
                    </div>
                }
            }
        </div></div>
    </div>
</div>
