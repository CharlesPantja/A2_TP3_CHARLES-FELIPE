@page
@model CityMove.Web.Pages.PassageiroModel
@{
    ViewData["Title"] = "Painel do Passageiro";
}

<div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-2">
    <h1 class="h3 m-0">Painel do Passageiro</h1>
    <span class="badge cm-badge">👤 Olá, @Model.Nome</span>
</div>
<p class="text-muted">Veja suas notificações e avalie sua viagem.</p>

@if (!string.IsNullOrEmpty(Model.Mensagem)) { <div class="alert alert-success">@Model.Mensagem</div> }
@if (!string.IsNullOrEmpty(Model.Erro)) { <div class="alert alert-danger">@Model.Erro</div> }

<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card cm-card h-100"><div class="card-body">
            <h2 class="h5 mb-3">⭐ Avaliar viagem</h2>
            <form method="post" asp-page-handler="Avaliar">
                <input type="hidden" asp-for="PassageiroId" value="@(Model.Ctx?.PassageiroId ?? 0)" />
                <div class="mb-2">
                    <label class="form-label">Linha do ônibus</label>
                    <input asp-for="Linha" class="form-control" required placeholder="Ex.: L001 - Centro / Plano Sul" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Placa do veículo</label>
                    <input asp-for="Placa" class="form-control" required maxlength="10" placeholder="Ex.: ABC1D23" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Quantas estrelas?</label>
                    <select asp-for="Nota" class="form-select">
                        @for (int n = 5; n >= 1; n--)
                        {
                            <option value="@n">@(new string('★', n)) (@n)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Mensagem (opcional)</label>
                    <textarea asp-for="Comentario" class="form-control" rows="3" placeholder="Como foi a viagem?"></textarea>
                </div>
                <button type="submit" class="btn btn-cm">Enviar avaliação</button>
            </form>
        </div></div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card cm-card h-100"><div class="card-body">
            <h2 class="h5 mb-3">🔔 Notificações</h2>
            @if (Model.Ctx is null || Model.Ctx.Notificacoes.Count == 0)
            {
                <p class="text-muted m-0">Nenhuma notificação.</p>
            }
            else
            {
                @foreach (var n in Model.Ctx.Notificacoes)
                {
                    <div class="d-flex justify-content-between align-items-start border-bottom py-2">
                        <span>@n.Mensagem</span>
                        <small class="text-muted text-nowrap ms-3">@n.EnviadaEm.ToLocalTime().ToString("dd/MM HH:mm")</small>
                    </div>
                }
            }
        </div></div>
    </div>
</div>
