@page
@model IndexModel
@{
    ViewData["Title"] = "Início";
}

<section class="cm-hero">
    <div class="cm-hero-content">
        <span class="cm-hero-tag">Transporte Urbano Inteligente</span>
        <h1 class="display-4 fw-bold mb-3">CityMove</h1>
        <p class="lead mb-4">
            A plataforma que conecta o cidadão ao transporte público da cidade.
            Consulte linhas, horários, paradas e a previsão do tempo &mdash; e, para a equipe
            de operação, gerencie toda a frota em um só lugar.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a href="#linhas" class="btn btn-cm btn-lg">Ver linhas disponíveis</a>
            <a asp-page="/Clima" class="btn btn-light btn-lg">Consultar clima</a>
        </div>
    </div>
</section>

<section class="mb-5">
    <h2 class="h4 mb-3 text-center">O que você pode fazer no CityMove</h2>
    <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card cm-card h-100 text-center">
                <div class="card-body">
                    <div class="cm-feature-icon">&#128652;</div>
                    <h5 class="mt-2">Linhas e rotas</h5>
                    <p class="text-muted mb-0">Veja todas as linhas de ônibus, o tipo de cada uma e a tarifa.</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card cm-card h-100 text-center">
                <div class="card-body">
                    <div class="cm-feature-icon">&#9200;</div>
                    <h5 class="mt-2">Horários e paradas</h5>
                    <p class="text-muted mb-0">Consulte os horários de partida e as paradas de cada linha.</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card cm-card h-100 text-center">
                <div class="card-body">
                    <div class="cm-feature-icon">&#9925;</div>
                    <h5 class="mt-2">Previsão do tempo</h5>
                    <p class="text-muted mb-0">Saiba como está o clima antes de sair, em tempo real.</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card cm-card h-100 text-center">
                <div class="card-body">
                    <div class="cm-feature-icon">&#128273;</div>
                    <h5 class="mt-2">Painel da operação</h5>
                    <p class="text-muted mb-0">A equipe gerencia linhas, veículos e motoristas com login seguro.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="linhas" class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 m-0">Linhas disponíveis</h2>
    <span class="badge cm-badge">@Model.Linhas.Count linha(s)</span>
</div>

@if (Model.Linhas.Count == 0)
{
    <div class="alert alert-warning">
        Nenhuma linha encontrada. Verifique se a <strong>CityMove.API</strong> está em execução
        (configurada em <code>ApiBaseUrl</code> no appsettings.json).
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var linha in Model.Linhas)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card cm-card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h5 class="card-title mb-1">@linha.Nome</h5>
                            <span class="badge cm-badge align-self-start">@linha.Codigo</span>
                        </div>
                        <p class="text-muted mb-2">@linha.TipoLinha</p>
                        <p class="mb-3">Tarifa: <strong>R$ @linha.Tarifa.ToString("0.00")</strong></p>
                        <a asp-page="/Linhas/Details" asp-route-id="@linha.Id" class="btn btn-cm-outline btn-sm">
                            Ver horários e paradas
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
