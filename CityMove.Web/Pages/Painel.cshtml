@page
@using System.Text.Json
@model CityMove.Web.Pages.PainelModel
@{
    ViewData["Title"] = "Painel";
}

<h1 class="h3 mb-1">Painel administrativo</h1>
<p class="text-muted">Bem-vindo, @Model.Nome.</p>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-page="/Admin/Linhas" class="btn btn-cm btn-sm">Gerir linhas</a>
    <a asp-page="/Admin/Rotas" class="btn btn-cm btn-sm">Gerir rotas</a>
    <a asp-page="/Admin/Veiculos" class="btn btn-cm btn-sm">Gerir veículos</a>
    <a asp-page="/Admin/Motoristas" class="btn btn-cm btn-sm">Gerir motoristas</a>
</div>

@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="alert alert-warning">@Model.Erro</div>
}
else if (Model.Relatorio is JsonElement r)
{
    <div class="row g-3 mt-1">
        <div class="col-6 col-md-3">
            <div class="card cm-card h-100"><div class="card-body">
                <p class="text-muted mb-1">Linhas</p>
                <p class="cm-metric mb-0">@PainelModel.Num(r, "totalLinhas")</p>
                <small class="text-muted">@PainelModel.Num(r, "linhasAtivas") ativas</small>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card cm-card h-100"><div class="card-body">
                <p class="text-muted mb-1">Veículos</p>
                <p class="cm-metric mb-0">@PainelModel.Num(r, "totalVeiculos")</p>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card cm-card h-100"><div class="card-body">
                <p class="text-muted mb-1">Motoristas</p>
                <p class="cm-metric mb-0">@PainelModel.Num(r, "totalMotoristas")</p>
                <small class="text-muted">@PainelModel.Num(r, "motoristasDisponiveis") disponíveis</small>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card cm-card h-100"><div class="card-body">
                <p class="text-muted mb-1">Viagens</p>
                <p class="cm-metric mb-0">@PainelModel.Num(r, "totalViagens")</p>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card cm-card h-100"><div class="card-body">
                <p class="text-muted mb-1">Ocorrências abertas</p>
                <p class="cm-metric mb-0">@PainelModel.Num(r, "ocorrenciasAbertas")</p>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card cm-card h-100"><div class="card-body">
                <p class="text-muted mb-1">Infrações</p>
                <p class="cm-metric mb-0">@PainelModel.Num(r, "totalInfracoes")</p>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card cm-card h-100"><div class="card-body">
                <p class="text-muted mb-1">Nota média</p>
                <p class="cm-metric mb-0">@PainelModel.Num(r, "notaMediaAvaliacoes")</p>
            </div></div>
        </div>
    </div>
}
