<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CityMove</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CityMove.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark cm-navbar mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">
                    <span class="cm-brand-icon"><img src="~/images/iconbus.png" alt="CityMove" /></span>
                    CityMove
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index">Linhas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Rastreamento">Mapa ao vivo</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Acompanhar">Acompanhar</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Clima">Clima</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("token") is not null)
                        {
                            var roles = Context.Session.GetString("roles") ?? "";
                            var painel = roles.Contains("Admin") ? "/Painel"
                                : roles.Contains("Motorista") ? "/Motorista"
                                : roles.Contains("Fiscal") ? "/Fiscal"
                                : roles.Contains("Passageiro") ? "/Passageiro" : "/Painel";
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-page="@painel">Meu painel</a></li>
                            <li class="nav-item">
                                <span class="nav-link">Olá, @Context.Session.GetString("nome")</span>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Logout">Sair</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Login">Entrar</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container cm-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container">
            &copy; 2026 - CityMove - Transporte Urbano Inteligente | Charles Pantoja & Felipe Ferreira
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
