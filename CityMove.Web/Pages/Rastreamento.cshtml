@page
@model CityMove.Web.Pages.RastreamentoModel
@{
    ViewData["Title"] = "Rastreamento ao vivo";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 m-0">Rastreamento ao vivo</h1>
        <p class="text-muted m-0">Posição dos ônibus em tempo real (dados de GPS via API).</p>
    </div>
    <span id="status" class="badge cm-badge">Carregando...</span>
</div>

<div id="map" style="height: 70vh; border-radius: 14px; box-shadow: 0 2px 10px rgba(0,0,0,.06);"></div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const map = L.map('map').setView([-10.2, -48.33], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap', maxZoom: 19
        }).addTo(map);

        const markers = {};

        async function atualizar() {
            try {
                const resp = await fetch('/Rastreamento?handler=Posicoes', { headers: { 'RequestVerificationToken': '' } });
                const dados = await resp.json();
                document.getElementById('status').textContent = dados.length + ' ônibus em circulação';

                dados.forEach(p => {
                    const lat = p.latitude, lng = p.longitude;
                    const texto = `<strong>${p.linhaCodigo} - ${p.linhaNome}</strong><br>` +
                                  `Placa: ${p.placa}<br>Velocidade: ${p.velocidade} km/h`;
                    if (markers[p.veiculoId]) {
                        markers[p.veiculoId].setLatLng([lat, lng]).getPopup().setContent(texto);
                    } else {
                        markers[p.veiculoId] = L.marker([lat, lng]).addTo(map).bindPopup(texto);
                    }
                });
            } catch (e) {
                document.getElementById('status').textContent = 'Falha ao atualizar';
            }
        }

        atualizar();
        setInterval(atualizar, 5000);
    </script>
}
